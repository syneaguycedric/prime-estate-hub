# Next.js Environment Variables Example

# Site URL (utilisé pour les meta tags et liens canoniques)
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Mode de développement
NODE_ENV=development

# API Directus Configuration
NEXT_PUBLIC_DIRECTUS_API_URL=https://ki-backoffice.eyoboue.dev:8143
NEXT_PUBLIC_USE_MOCK_DATA=false  # true pour utiliser les données mockées, false pour l'API

# Directus Assets URL (pour construire les URLs d'images)
NEXT_PUBLIC_DIRECTUS_ASSETS_URL=https://ki-backoffice.eyoboue.dev:8143/assets

# Clés API (à ajouter selon les besoins)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# OPENWEATHER_API_KEY=

# Configuration de performance
NEXT_TELEMETRY_DISABLED=1

# Configuration Redis (pour le cache en production)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# Configuration base de données (pour les données réelles)
# DATABASE_URL=
# DATABASE_PASSWORD=

# Configuration d'authentification (à implémenter plus tard)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# Configuration de stockage des images
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
